# The exact origin used in the browser and Google Cloud Console. Optional on Vercel.
BETTER_AUTH_URL=http://localhost:3000
# Generate with bun run setup (or openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Local SQLite for development; libsql://... and a token for hosted Turso.
# On Vercel, the Turso integration's TURSO_DATABASE_URL/TURSO_AUTH_TOKEN also work.
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=
# Google Cloud Console > Google Auth Platform > Clients > Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional comma-separated, verified Google emails allowed to manage projects.
MODERATOR_EMAILS=
